# Local setup creates .env with unique keys. Do not copy blank signing keys.
ENVIRONMENT=development
DEBUG=false
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
COOKIE_SECURE=false
REQUIRE_REDIS=false
# Registration is open by default: the first account becomes ADMIN (machine owner)
# and every later sign-up is a read-only VIEWER. Set false for public deployments.
ALLOW_REGISTRATION=true
# True only when traffic reaches the app through the bundled nginx (compose sets it).
TRUST_PROXY=false
# Shared secret for recorder agent connections (Start_Recorder_Agent.bat auto-reads it).
RECORDER_AGENT_TOKEN=
# Hard ceiling for one Playwright automation run, in seconds (killed on expiry).
AUTOMATION_RUN_TIMEOUT=1800
# --- docker compose edge (Caddy) ---
# Published bind of the Caddy edge: localhost-only by default; 0.0.0.0 for a
# public VPS. Plain HTTP on port 80 is the default (SITE_ADDRESS=:80).
# HTTP_BIND=0.0.0.0
# For automatic HTTPS on a real domain use the https overlay and set:
# DOMAIN=example.com
# Advanced: override the edge site address directly, e.g.
# SITE_ADDRESS=https://example.com
# Omit DATABASE_URL for local SQLite at backend/creator_platform.db.
# DATABASE_URL=postgresql+asyncpg://creator:URL_ENCODED_PASSWORD@localhost:5432/creator_platform
# JWT_SECRET=GENERATE_UNIQUE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
# JWT_REFRESH_SECRET=GENERATE_ANOTHER_UNIQUE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:5173,http://127.0.0.1:5173
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Optional real stock-photo backgrounds for History / Indian Law videos.
PEXELS_API_KEY=
# Daily Tamil news video: ten recent stories from public publisher RSS feeds,
# each scene credited to its publisher. Narration is the publisher's own short
# summary (accurate, attributed) by default. Set NEWS_AI_REWRITE=true to have
# the local model rewrite it in its own words - review a few videos first,
# because a small model can invert a fact.
NEWS_AI_REWRITE=false
NEWS_MODEL=gemma3:4b
STORAGE_PROVIDER=local
# STORAGE_PATH=G:/creator-media
# TLS_CERTFILE=
# TLS_KEYFILE=
# Provider credentials below are reserved for future adapters; currently unused.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
PAYMENT_PROVIDER=
PAYMENT_KEY=
