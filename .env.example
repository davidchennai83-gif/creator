# Local setup creates .env with unique keys. Do not copy blank signing keys.
ENVIRONMENT=development
DEBUG=false
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
COOKIE_SECURE=false
REQUIRE_REDIS=false
ALLOW_REGISTRATION=true
# Omit DATABASE_URL for local SQLite at backend/creator_platform.db.
# DATABASE_URL=postgresql+asyncpg://creator:URL_ENCODED_PASSWORD@localhost:5432/creator_platform
# JWT_SECRET=GENERATE_UNIQUE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
# JWT_REFRESH_SECRET=GENERATE_ANOTHER_UNIQUE_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:5173,http://127.0.0.1:5173
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Optional real stock-photo backgrounds for History / Indian Law videos.
PEXELS_API_KEY=
STORAGE_PROVIDER=local
# STORAGE_PATH=G:/creator-media
# TLS_CERTFILE=
# TLS_KEYFILE=
# Provider credentials below are reserved for future adapters; currently unused.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
PAYMENT_PROVIDER=
PAYMENT_KEY=
