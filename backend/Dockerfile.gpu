# Optional GPU worker base; actual video/TTS tasks remain unimplemented.
FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04
WORKDIR /app/backend
RUN apt-get update && apt-get install -y python3 python3-venv ffmpeg && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && useradd --create-home creator
COPY --chown=creator:creator . .
RUN mkdir -p storage && chown -R creator:creator /app/backend
USER creator
CMD ["python", "-m", "celery", "-A", "app.workers.base:celery_app", "worker", "-Q", "video_queue,ai_queue", "--concurrency=1", "--loglevel=info"]
